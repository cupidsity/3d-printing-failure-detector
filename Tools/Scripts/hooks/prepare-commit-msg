#!/usr/bin/env python3
# prepare-commit-msg hook that lays out the commit message format described in
# the readme. git runs it right before opening the editor. `git-sd1 commit` sets
# the environment variables read below; a plain `git commit` still gets the
# template, just without the issue title or the --update behavior.
#
# this is the source copy. `git-sd1 setup` installs it into .git/hooks, so rerun
# that after editing this file.

import os
import re
import subprocess
import sys
from dataclasses import dataclass, field

UPDATE_VARIABLE = 'SD1_COMMIT_UPDATE'
TITLE_VARIABLE = 'SD1_COMMIT_TITLE'
ISSUE_URL_VARIABLE = 'SD1_COMMIT_ISSUE_URL'

# every unfinished placeholder carries "(OOPS!)" so one search, by a person or
# by the github format check, finds everything still left to fill in
TITLE_PLACEHOLDER = 'Need a short descriptive title (OOPS!).'
REVIEWER_PLACEHOLDER = 'Reviewed by NOBODY (OOPS!).'
DESCRIPTION_PLACEHOLDER = 'Need a description of what changed and why (OOPS!).'

SCISSORS_SUFFIX = '------------------------ >8 ------------------------'
FILE_ENTRY_PATTERN = re.compile(r'^\* (\S[^:]*):')
FUNCTION_LINE_PATTERN = re.compile(r'^\((.+?)\):')
TRAILER_PATTERN = re.compile(r'^[A-Za-z][A-Za-z0-9-]*: \S')

CODE_EXTENSIONS = {'.py', '.js', '.jsx', '.mjs', '.ts', '.tsx', '.c', '.h', '.cc', '.cpp', '.hpp', '.ino'}
C_FAMILY_EXTENSIONS = {'.c', '.h', '.cc', '.cpp', '.hpp', '.ino'}

# only definitions count on lines the diff adds or removes, otherwise every call
# like `send_command(pause)` inside a function body would be listed as a change
DEFINITION_PATTERNS = [
    re.compile(r'^\s*(?:async\s+)?def\s+([A-Za-z_]\w*)'),
    re.compile(r'^\s*(?:export\s+)?(?:default\s+)?(?:abstract\s+)?class\s+([A-Za-z_$][\w$]*)'),
    re.compile(r'^\s*(?:export\s+)?(?:default\s+)?(?:async\s+)?function\s*\*?\s*([A-Za-z_$][\w$]*)'),
    re.compile(r'^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*(?::[^=]+)?=\s*'
               r'(?:async\s+)?(?:\([^)]*\)|[A-Za-z_$][\w$]*)\s*(?::[^=]+)?=>'),
]
# hunk headers for c code look like "static int home_axis(struct stepper *motor)"
C_FUNCTION_PATTERN = re.compile(r'([A-Za-z_]\w*)\s*\([^;]*$')
C_KEYWORDS = {'if', 'for', 'while', 'switch', 'return', 'sizeof', 'catch'}


@dataclass
class Change:
    kind: str
    path: str
    old_path: str = None
    functions: list = field(default_factory=list)


@dataclass
class ParsedMessage:
    preamble: list
    entries: dict
    trailers: list


def run_git(*arguments, check=True):
    result = subprocess.run(['git', *arguments], capture_output=True, text=True,
                            encoding='utf-8', errors='replace')
    if check and result.returncode:
        raise subprocess.CalledProcessError(result.returncode, result.args, result.stdout, result.stderr)
    return result


def comment_character():
    configured = run_git('config', 'core.commentChar', check=False).stdout.strip()
    return configured if configured and configured != 'auto' else '#'


def empty_tree():
    # computed instead of hardcoded so sha256 repositories work too
    return run_git('hash-object', '-t', 'tree', os.devnull).stdout.strip()


def diff_base(amending):
    # when amending, the commit being rewritten is already HEAD, so its changes
    # are everything between HEAD's parent and the index
    revision = 'HEAD^' if amending else 'HEAD'
    if run_git('rev-parse', '--verify', '--quiet', revision, check=False).returncode == 0:
        return revision
    return empty_tree()


def staged_changes(base):
    # -z keeps paths containing spaces or non-ascii characters unquoted
    tokens = run_git('diff', '--cached', '--name-status', '-z', '-M', base).stdout.split('\0')
    changes = []
    position = 0
    while position < len(tokens) and tokens[position]:
        kind = tokens[position][0]
        if kind in 'RC':
            changes.append(Change(kind, tokens[position + 2], old_path=tokens[position + 1]))
            position += 3
        else:
            changes.append(Change(kind, tokens[position + 1]))
            position += 2
    return changes


def parse_hunks(diff_text):
    hunks = []
    for line in diff_text.splitlines():
        if line.startswith('@@'):
            parts = line.split('@@', 2)
            hunks.append((parts[2].strip() if len(parts) == 3 else '', []))
        # the "+++"/"---" file header comes before the first hunk, so anything
        # starting with +/- after a hunk has begun is a real changed line
        elif hunks and line.startswith(('+', '-')):
            hunks[-1][1].append(line[1:])
    return hunks


def definition_name(line):
    for pattern in DEFINITION_PATTERNS:
        match = pattern.match(line)
        if match:
            return match.group(1)
    return None


def context_name(context, extension):
    name = definition_name(context)
    if name or extension not in C_FAMILY_EXTENSIONS:
        return name
    match = C_FUNCTION_PATTERN.search(context)
    if match and match.group(1) not in C_KEYWORDS:
        return match.group(1)
    return None


def functions_from_diff(diff_text, extension):
    names = []
    for context, changed_lines in parse_hunks(diff_text):
        hunk_names = [definition_name(line) for line in changed_lines]
        # the hunk header names the definition *above* the hunk. when the hunk
        # starts on a definition line itself, that header points at the previous
        # function, which wasn't touched
        starts_on_definition = bool(hunk_names) and hunk_names[0] is not None
        if not starts_on_definition:
            names.append(context_name(context, extension))
        names.extend(hunk_names)
    return list(dict.fromkeys(name for name in names if name))


def changed_functions(base, change):
    extension = os.path.splitext(change.path)[1].lower()
    # a brand new or deleted file would list every function in it, which says nothing
    if change.kind in 'AD' or extension not in CODE_EXTENSIONS:
        return []
    paths = [change.old_path, change.path] if change.old_path else [change.path]
    diff_text = run_git('diff', '--cached', '-U0', '-M', '--no-color', '--no-ext-diff', base, '--', *paths).stdout
    return functions_from_diff(diff_text, extension)


def entry_lines(change):
    notes = {'A': 'Added.', 'D': 'Removed.', 'R': f'Renamed from {change.old_path}.', 'C': f'Copied from {change.old_path}.'}
    header = f'* {change.path}:'
    if change.kind in notes:
        header += ' ' + notes[change.kind]
    return [header] + [f'({name}):' for name in change.functions]


def strip_trailing_blanks(lines):
    lines = list(lines)
    while lines and not lines[-1].strip():
        lines.pop()
    return lines


def split_comments(text, comment_char):
    # git has already written its status comments (and, for `commit -v`, the diff
    # below the scissors line) before running this hook. they have to stay at the
    # bottom, and everything after the scissors must be kept byte for byte
    lines = text.splitlines()
    body, comments = [], []
    for position, line in enumerate(lines):
        if line.startswith(comment_char) and line.endswith(SCISSORS_SUFFIX):
            comments.extend(lines[position:])
            break
        (comments if line.startswith(comment_char) else body).append(line)
    return body, comments


def parse_message(body_lines):
    lines = strip_trailing_blanks(body_lines)
    entry_start = next((position for position, line in enumerate(lines) if FILE_ENTRY_PATTERN.match(line)), None)
    if entry_start is None:
        return ParsedMessage(lines, {}, [])

    # a closing paragraph of trailers (Signed-off-by:, Co-authored-by:) has to stay
    # after the file list instead of being swallowed into the last entry
    trailers = []
    last_blank = max((position for position, line in enumerate(lines) if not line.strip()), default=-1)
    final_paragraph = lines[last_blank + 1:]
    if last_blank > entry_start and all(TRAILER_PATTERN.match(line) for line in final_paragraph):
        trailers = final_paragraph
        lines = strip_trailing_blanks(lines[:last_blank])

    entries = {}
    current_path = None
    for line in lines[entry_start:]:
        match = FILE_ENTRY_PATTERN.match(line)
        if match:
            current_path = match.group(1)
            entries[current_path] = []
        entries[current_path].append(line)
    return ParsedMessage(strip_trailing_blanks(lines[:entry_start]), entries, trailers)


def merge_entry(existing, change):
    entry = strip_trailing_blanks(existing)
    # keep a blank separator line the developer put after this entry
    spacing = existing[len(entry):][:1]
    if change.old_path and FILE_ENTRY_PATTERN.match(entry[0]).group(1) == change.old_path:
        entry[0] = f'* {change.path}' + entry[0][len(f'* {change.old_path}'):]

    written = '\n'.join(entry)
    missing = [name for name in change.functions if not re.search(rf'(?<![\w$]){re.escape(name)}(?![\w$])', written)]
    last_function_line = max((position for position, line in enumerate(entry) if FUNCTION_LINE_PATTERN.match(line)), default=0)
    entry[last_function_line + 1:last_function_line + 1] = [f'({name}):' for name in missing]
    return entry + spacing


def reconcile(parsed, changes):
    # returns the new file list plus the entries whose files left the commit, so
    # nothing the developer wrote disappears without them seeing it
    remaining = dict(parsed.entries)
    file_lines = []
    for change in changes:
        existing = remaining.pop(change.path, None)
        if existing is None and change.old_path:
            existing = remaining.pop(change.old_path, None)
        file_lines.extend(entry_lines(change) if existing is None else merge_entry(existing, change))
    return strip_trailing_blanks(file_lines), [strip_trailing_blanks(entry) for entry in remaining.values()]


def build_new_message(changes, title, issue_url, comment_char):
    lines = [title or TITLE_PLACEHOLDER]
    if issue_url:
        lines.append(issue_url)
    lines += ['', REVIEWER_PLACEHOLDER, '', DESCRIPTION_PLACEHOLDER]
    file_lines = [line for change in changes for line in entry_lines(change)]
    if file_lines:
        lines += [''] + file_lines
    hints = [
        'Replace every line marked (OOPS!) before pushing. The issue link under the title is',
        'optional: `git-sd1 commit --issue <number>` fills it in along with the issue title.',
        'Explain a specific file or function by writing after its colon.',
    ]
    return lines, [f'{comment_char} {hint}' for hint in hints]


def build_amended_message(body_lines, changes, comment_char):
    parsed = parse_message(body_lines)
    file_lines, dropped = reconcile(parsed, changes)
    lines = list(parsed.preamble)
    if file_lines:
        lines += [''] + file_lines
    if parsed.trailers:
        lines += [''] + parsed.trailers
    while lines and not lines[0].strip():
        lines.pop(0)

    hints = [f'{comment_char} git-sd1 refreshed the file list above to match this commit.']
    if dropped:
        hints.append(f'{comment_char} These entries were dropped because their files are no longer in the commit.')
        hints.append(f'{comment_char} Copy back anything worth keeping:')
        hints += [f'{comment_char}    {line}' for entry in dropped for line in entry]
    return lines, hints


def main(message_path, source='', commit_sha=''):
    # -m/-F messages, merges, squashes and commit.template are left alone: the
    # person committing already chose what the message should say
    if source not in ('', 'commit'):
        return 0

    with open(message_path, encoding='utf-8') as message_file:
        text = message_file.read()
    comment_char = comment_character()
    body, comments = split_comments(text, comment_char)

    if source == 'commit':
        amending = commit_sha == 'HEAD'
        if os.environ.get(UPDATE_VARIABLE) != '1' or not amending:
            if amending:
                comments = [f'{comment_char} Run `git-sd1 commit --update` instead to refresh the file list.'] + comments
            lines, hints = strip_trailing_blanks(body), []
        else:
            base = diff_base(amending=True)
            changes = staged_changes(base)
            for change in changes:
                change.functions = changed_functions(base, change)
            lines, hints = build_amended_message(body, changes, comment_char)
    else:
        if any(line.strip() for line in body):
            return 0
        base = diff_base(amending=False)
        changes = staged_changes(base)
        for change in changes:
            change.functions = changed_functions(base, change)
        lines, hints = build_new_message(changes, os.environ.get(TITLE_VARIABLE), os.environ.get(ISSUE_URL_VARIABLE), comment_char)

    # git sets GIT_EDITOR=: for hooks when no editor will open (--no-edit), and
    # then nothing strips comment lines, so hints would end up in the commit.
    # print them instead so dropped notes are still visible
    if os.environ.get('GIT_EDITOR') == ':':
        if len(hints) > 1:
            print('\n'.join(hint[len(comment_char):].strip() for hint in hints), file=sys.stderr)
        hints, comments = [], []
    if hints and comments:
        hints.append(comment_char)
    output = lines + [''] + hints + comments
    with open(message_path, 'w', encoding='utf-8') as message_file:
        message_file.write('\n'.join(output) + '\n')
    return 0


if __name__ == '__main__':
    sys.exit(main(*sys.argv[1:4]))
