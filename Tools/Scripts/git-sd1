#!/usr/bin/env python3
# repository helper for commits and pull requests. put Tools/Scripts on your PATH
# to run it as `git-sd1 <command>` from anywhere; setup prints the line to add.
# setup also installs a `git sd1` alias as a fallback for clones not on the PATH.
#
#   git-sd1 setup                   install the repository's git hooks (rerun after they change)
#   git-sd1 commit                  new commit from the staged changes, formatted by the hook
#   git-sd1 commit --issue 24       also link issue 24 and use its title
#   git-sd1 amend                   amend the last commit and refresh its file list
#   git-sd1 pr                      commit anything staged, push, and open or update the pull request
#   git-sd1 land 12                 rebase pull request 12 onto main and push it there without a merge commit
#                                   (the merge-queue github workflow runs this when the label is added)
#
# arguments `commit` and `amend` don't recognize (-a, -v, paths, ...) go straight to git commit.

import argparse
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from pathlib import Path

REPOSITORY_ROOT = Path(__file__).resolve().parents[2]
HOOKS_SOURCE = Path(__file__).resolve().parent / 'hooks'
# written into every installed hook so reruns know which hooks they own and never
# overwrite one a developer added by hand
INSTALLED_MARKER = '# installed by git-sd1 setup'
# git runs "!" aliases from the top of the work tree, so a relative path to the
# script works from any subdirectory and always runs this clone's own copy
GIT_ALIAS = '!Tools/Scripts/git-sd1'

# names shared with hooks/prepare-commit-msg, which reads them
UPDATE_VARIABLE = 'SD1_COMMIT_UPDATE'
TITLE_VARIABLE = 'SD1_COMMIT_TITLE'
ISSUE_URL_VARIABLE = 'SD1_COMMIT_ISSUE_URL'

# overridable so the tests can point pr at a fake github server
GITHUB_API = os.environ.get('SD1_GITHUB_API', 'https://api.github.com')
BRANCH_PREFIX = 'eng/'
PLACEHOLDER_MARKER = '(OOPS!)'
REVIEWER_PLACEHOLDER = 'Reviewed by NOBODY (OOPS!).'
MERGE_QUEUE_LABEL = 'merge-queue'
# how long land waits for github to notice the pushed commits and mark the pull
# request merged; overridable so the tests don't sit through it
MERGED_POLL_SECONDS = float(os.environ.get('SD1_MERGED_POLL_SECONDS', '10'))

GITHUB_REMOTE_PATTERN = re.compile(r'github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$')
REMOTE_USERNAME_PATTERN = re.compile(r'^https://([^@/:]+)(?::[^@/]*)?@github\.com/')
ISSUE_URL_PATTERN = re.compile(r'github\.com/([^/]+)/([^/]+)/issues/(\d+)')


class GitHubError(Exception):
    pass


def git_output(*arguments):
    result = subprocess.run(['git', *arguments], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else None


def git_succeeds(*arguments, quiet=True):
    output = subprocess.DEVNULL if quiet else None
    return subprocess.run(['git', *arguments], stdout=output, stderr=output).returncode == 0


def fail(message):
    print(f'git-sd1: {message}', file=sys.stderr)
    return 1


def installed_hooks_directory():
    # --git-path follows worktrees and core.hooksPath, so this is wherever git
    # will actually look for hooks in this clone
    hooks_path = git_output('rev-parse', '--git-path', 'hooks')
    return Path(hooks_path).resolve() if hooks_path else None


def install_hook(source, destination, force):
    if destination.exists() and INSTALLED_MARKER not in destination.read_text(encoding='utf-8', errors='replace'):
        if not force:
            print(f'skipped {destination.name}: {destination} already exists and wasn\'t installed by git-sd1. '
                  f'rerun with --force to replace it (the old one is kept as {destination.name}.backup)')
            return False
        shutil.copy2(destination, destination.with_name(destination.name + '.backup'))

    lines = source.read_text(encoding='utf-8').splitlines(keepends=True)
    # the shebang has to stay on the first line for git to run the hook
    lines.insert(1, f'{INSTALLED_MARKER} from {source.relative_to(REPOSITORY_ROOT).as_posix()}; '
                    'edit that file and rerun setup instead of editing this copy\n')
    destination.write_text(''.join(lines), encoding='utf-8')
    destination.chmod(destination.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print(f'installed {destination.name} -> {destination}')
    return True


def run_setup(options):
    hooks_directory = installed_hooks_directory()
    if hooks_directory is None:
        return fail('not inside a git repository')
    hooks_directory.mkdir(parents=True, exist_ok=True)
    results = [install_hook(source, hooks_directory / source.name, options.force)
               for source in sorted(HOOKS_SOURCE.iterdir()) if source.is_file()]

    existing_alias = git_output('config', '--local', 'alias.sd1')
    if existing_alias not in (None, GIT_ALIAS) and not options.force:
        print(f'skipped the `git sd1` alias: alias.sd1 is already set to "{existing_alias}". rerun with --force to replace it')
        results.append(False)
    else:
        git_succeeds('config', '--local', 'alias.sd1', GIT_ALIAS)
        print('installed the `git sd1` alias for this clone')

    on_path = shutil.which('git-sd1')
    if not on_path or Path(on_path).resolve() != Path(__file__).resolve():
        # setup can't change the parent shell's PATH, so say exactly what to add
        print('\nto run this as `git-sd1` from anywhere, add Tools/Scripts to your PATH, e.g. in ~/.zshrc or ~/.bashrc:')
        print(f'    export PATH="{Path(__file__).resolve().parent}:$PATH"')
    return 0 if all(results) else 1


def origin_url():
    # the raw config value, not `git remote get-url`, which applies insteadOf
    # rewrites and can turn a github url into something unrecognizable
    return git_output('config', 'remote.origin.url') or ''


def github_repository():
    match = GITHUB_REMOTE_PATTERN.search(origin_url())
    return match.groups() if match else None


def github_token():
    token = os.environ.get('GITHUB_TOKEN') or os.environ.get('GH_TOKEN')
    if token:
        return token
    # fall back to the token the credential helper already stores for pushing,
    # so anyone who can push can open pull requests without extra setup
    username_match = REMOTE_USERNAME_PATTERN.match(origin_url())
    query = 'protocol=https\nhost=github.com\n'
    if username_match:
        query += f'username={username_match.group(1)}\n'
    result = subprocess.run(['git', 'credential', 'fill'], input=query + '\n', capture_output=True, text=True,
                            env={**os.environ, 'GIT_TERMINAL_PROMPT': '0'})
    if result.returncode:
        return None
    for line in result.stdout.splitlines():
        if line.startswith('password='):
            return line[len('password='):]
    return None


def github_request(method, path, token=None, payload=None):
    request = urllib.request.Request(GITHUB_API + path, method=method,
                                     data=json.dumps(payload).encode() if payload is not None else None,
                                     headers={'Accept': 'application/vnd.github+json',
                                              'Content-Type': 'application/json'})
    if token:
        request.add_header('Authorization', f'Bearer {token}')
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            # deletes answer 204 with no body
            body = response.read()
            return json.loads(body) if body else None
    except urllib.error.HTTPError as error:
        # github explains validation failures (like "a pull request already
        # exists") in the body, which is far more useful than the status line
        try:
            details = json.load(error)
            reason = details.get('message', '')
            reason += ''.join(f'; {item.get("message") or item}' for item in details.get('errors', []))
        except ValueError:
            reason = error.reason
        raise GitHubError(f'{error.code} {reason}') from error
    except (urllib.error.URLError, TimeoutError) as error:
        raise GitHubError(str(error)) from error


def resolve_issue(issue_argument):
    url_match = ISSUE_URL_PATTERN.search(issue_argument)
    if url_match:
        return url_match.groups()
    if not issue_argument.lstrip('#').isdigit():
        raise ValueError(f'--issue takes an issue number or url, not "{issue_argument}"')
    repository = github_repository()
    if repository is None:
        raise ValueError('origin isn\'t a github remote, so pass the full issue url to --issue')
    return (*repository, issue_argument.lstrip('#'))


def fetch_issue_title(owner, repository, number):
    try:
        return github_request('GET', f'/repos/{owner}/{repository}/issues/{number}', github_token()).get('title')
    except GitHubError as error:
        # the commit still goes ahead with the title placeholder
        print(f'git-sd1: couldn\'t fetch the title of issue #{number} ({error}). fill it in yourself', file=sys.stderr)
        return None


def hook_is_installed():
    hooks_directory = installed_hooks_directory()
    hook = hooks_directory / 'prepare-commit-msg' if hooks_directory else None
    return bool(hook and hook.exists() and INSTALLED_MARKER in hook.read_text(encoding='utf-8', errors='replace'))


def commit(update, issue, git_arguments):
    if not hook_is_installed():
        print('git-sd1: the commit hook isn\'t installed, so the message won\'t be formatted. '
              'run `git-sd1 setup` first', file=sys.stderr)

    # start from a clean slate so values left in the shell from an earlier run
    # can't leak into this commit
    environment = {name: value for name, value in os.environ.items()
                   if name not in (UPDATE_VARIABLE, TITLE_VARIABLE, ISSUE_URL_VARIABLE)}
    command = ['git', 'commit']
    if update:
        command.append('--amend')
        environment[UPDATE_VARIABLE] = '1'
    if issue:
        try:
            owner, repository, number = resolve_issue(issue)
        except ValueError as error:
            return fail(str(error))
        environment[ISSUE_URL_VARIABLE] = f'https://github.com/{owner}/{repository}/issues/{number}'
        title = fetch_issue_title(owner, repository, number)
        if title:
            environment[TITLE_VARIABLE] = title
    return subprocess.run(command + git_arguments, env=environment).returncode


def run_commit(options, git_arguments):
    return commit(False, options.issue, git_arguments)


def run_amend(git_arguments):
    return commit(True, None, git_arguments)


def default_base_branch():
    remote_head = git_output('symbolic-ref', '--short', '-q', 'refs/remotes/origin/HEAD')
    return remote_head.split('/', 1)[1] if remote_head else 'main'


def commits_ahead(upstream):
    output = git_output('rev-list', '--reverse', f'{upstream}..HEAD')
    return output.split() if output else []


def commit_message(revision):
    return git_output('log', '-1', '--format=%B', revision) or ''


def split_title(message):
    title, _, body = message.strip().partition('\n')
    return title.strip(), body.strip()


def branch_exists(name):
    # the remote counts too: a name that is only on origin is still someone's
    # branch, and reusing it would push onto their work
    return (git_succeeds('show-ref', '--verify', '--quiet', f'refs/heads/{name}')
            or git_succeeds('show-ref', '--verify', '--quiet', f'refs/remotes/origin/{name}'))


def branch_name_for(title):
    slug = re.sub(r'[^a-z0-9]+', '-', title.lower()).strip('-')[:50].rstrip('-') or 'change'
    name = BRANCH_PREFIX + slug
    counter = 2
    while branch_exists(name):
        name = f'{BRANCH_PREFIX}{slug}-{counter}'
        counter += 1
    return name


def unfinished_placeholders(messages):
    # placeholders are whole lines ending in the marker, so a description that
    # merely talks about "(OOPS!)" mid-sentence isn't flagged. the reviewer line is
    # expected to stay a placeholder until someone approves the pull request
    return [line for message in messages for line in message.splitlines()
            if line.rstrip().rstrip('.').endswith(PLACEHOLDER_MARKER) and not line.startswith('Reviewed by')]


def pull_request_text(messages):
    # the commit message is the source of truth, so the description is rebuilt
    # from it on every run instead of being edited on github
    title, body = split_title(messages[0])
    if len(messages) == 1:
        return title, body
    sections = []
    for message in messages:
        commit_title, commit_body = split_title(message)
        sections.append(f'#### {commit_title}\n\n{commit_body}'.strip())
    return title, '\n\n'.join(sections)


def account_note(pull_request):
    # the token can come from a credential helper or an editor's github login, so
    # say which account it belongs to; a wrong account is obvious right away
    login = (pull_request.get('user') or {}).get('login')
    return f' as {login}' if login else ''


def ask(question):
    # stdin can be closed, which is what happens in a script or a ci job. that
    # reads as no answer rather than as a yes
    try:
        return input(question).strip()
    except EOFError:
        return None


def describe_pull_request(pull_request):
    if pull_request.get('merged_at'):
        return f'#{pull_request["number"]} (merged {pull_request["merged_at"][:10]})'
    return f'#{pull_request["number"]} (closed without merging)'


def finished_pull_requests(owner, repository_name, branch, token):
    query = urllib.parse.urlencode({'head': f'{owner}:{branch}', 'state': 'all'})
    pull_requests = github_request('GET', f'/repos/{owner}/{repository_name}/pulls?{query}', token)
    # an open pull request for this branch means this run only updates it, which
    # is the normal review loop and not a reused branch
    if any(pull_request.get('state') != 'closed' for pull_request in pull_requests):
        return []
    return [pull_request for pull_request in pull_requests if pull_request.get('state') == 'closed']


def move_to_branch(branch, replacement, branch_is_ours):
    # a branch this run created is renamed, since nothing else points at it. one
    # the developer made is left where it is and the commits are branched off it
    if branch_is_ours:
        return git_succeeds('branch', '--move', replacement)
    return git_succeeds('switch', '--quiet', '-c', replacement, quiet=False)


def ask_for_replacement_branch():
    while True:
        replacement = ask('name for the branch to use instead (blank to stop): ')
        if not replacement:
            return None
        if '/' not in replacement:
            replacement = BRANCH_PREFIX + replacement
        if not git_succeeds('check-ref-format', '--branch', replacement):
            print(f'git-sd1: "{replacement}" isn\'t a valid branch name')
        elif branch_exists(replacement):
            print(f'git-sd1: {replacement} already exists')
        else:
            return replacement


def confirm_branch_is_new(owner, repository_name, branch, token, branch_is_ours, reuse_allowed):
    # every pull request is supposed to start from its own branch. a branch whose
    # pull request already closed has usually been landed and reused by accident,
    # and pushing onto it again buries the new commits under a finished review
    while True:
        try:
            closed = finished_pull_requests(owner, repository_name, branch, token)
        except GitHubError as error:
            # the check is a safeguard, not the job: say it didn't run and carry on
            print(f'git-sd1: couldn\'t check whether {branch} was used before ({error})', file=sys.stderr)
            return branch, None
        if not closed:
            return branch, None
        listed = ' and '.join(describe_pull_request(pull_request) for pull_request in closed)
        if reuse_allowed:
            print(f'git-sd1: reusing {branch}, which already had pull request {listed}')
            return branch, None
        print(f'git-sd1: {branch} already had pull request {listed}, so this would be a second '
              f'pull request from the same branch name.')
        answer = ask(f'open another pull request from {branch} anyway? [y/N] ')
        if answer is None:
            return branch, (f'{branch} already had pull request {listed}, and there is no terminal to ask on. '
                            'rerun with --branch NAME for a different branch, or --reuse-branch to use this one anyway')
        if answer.lower() in ('y', 'yes'):
            return branch, None
        replacement = ask_for_replacement_branch()
        if replacement is None:
            return branch, f'{branch} already had pull request {listed}'
        if not move_to_branch(branch, replacement, branch_is_ours):
            return branch, f'couldn\'t move your commits onto {replacement}'
        print(f'git-sd1: using {replacement}')
        branch = replacement


def undo_branch(branch, base, base_position):
    # nothing has been pushed yet, so putting the base back where it was leaves
    # the commits exactly where they were before this run
    git_succeeds('branch', '--force', base, base_position)
    git_succeeds('switch', '--quiet', base, quiet=False)
    git_succeeds('branch', '--delete', '--force', branch)


def run_pr(options):
    repository = github_repository()
    if repository is None:
        return fail('origin isn\'t a github remote')
    owner, repository_name = repository
    base = options.base or default_base_branch()
    upstream = f'origin/{base}'
    current_branch = git_output('symbolic-ref', '--short', '-q', 'HEAD')
    if current_branch is None:
        return fail('HEAD is detached; check out a branch first')
    if not git_succeeds('fetch', '--quiet', 'origin', base, quiet=False):
        return fail(f'couldn\'t fetch {upstream}')

    has_staged_changes = not git_succeeds('diff', '--cached', '--quiet')
    if has_staged_changes:
        # staged work on a branch that already has its commit is
        # folded into that commit instead of piling up review-fix commits
        update = current_branch != base and bool(commits_ahead(upstream))
        exit_code = commit(update, None if update else options.issue, [])
        if exit_code:
            return exit_code
    elif not git_succeeds('diff', '--quiet'):
        print('git-sd1: unstaged changes are not included; `git add` them and rerun to put them in the pull request',
              file=sys.stderr)

    ahead = commits_ahead(upstream)
    if not ahead:
        return fail(f'nothing to open a pull request for: no commits ahead of {upstream}')

    branch_is_ours = current_branch == base
    base_before_branching = None
    if branch_is_ours:
        base_before_branching = git_output('rev-parse', base)
        branch = options.branch or branch_name_for(split_title(commit_message(ahead[0]))[0])
        if not git_succeeds('switch', '--quiet', '-c', branch, quiet=False):
            return fail(f'couldn\'t create {branch}')
        # the commits now live on the new branch, so the local base goes back to
        # matching the remote and stays clean for the next piece of work
        git_succeeds('branch', '--force', base, upstream)
        print(f'git-sd1: moved your commits onto {branch}; {base} now matches {upstream}')
        current_branch = branch

    if not options.no_rebase and not git_succeeds('rebase', '--quiet', '--autostash', upstream, quiet=False):
        return fail(f'rebasing onto {upstream} hit conflicts. resolve them, run `git rebase --continue`, '
                    'then rerun `git-sd1 pr` (or `git rebase --abort` to back out)')

    messages = [commit_message(revision) for revision in commits_ahead(upstream)]
    placeholders = unfinished_placeholders(messages)
    if placeholders and not options.draft:
        listed = '\n'.join(f'    {line}' for line in placeholders)
        return fail(f'these lines still need filling in (fix them with `git-sd1 amend`, '
                    f'or pass --draft to open a draft anyway):\n{listed}')

    # the last thing before the push, so refusing the branch leaves the remote
    # untouched and the commits exactly where this run found them
    token = github_token()
    if token is not None:
        current_branch, refusal = confirm_branch_is_new(owner, repository_name, current_branch, token,
                                                        branch_is_ours, options.reuse_branch)
        if refusal:
            if branch_is_ours:
                undo_branch(current_branch, base, base_before_branching)
                return fail(f'{refusal}. your commits are back on {base} and nothing was pushed; '
                            'rerun with `--branch NAME` to put them on a different branch')
            return fail(f'{refusal}. nothing was pushed; move your commits onto a new branch '
                        '(`git switch -c eng/NAME`) and rerun')

    # force because `git-sd1 amend` rewrites the commit; the lease still
    # refuses if someone else pushed to this branch since the last fetch
    if not git_succeeds('push', '--quiet', '--force-with-lease', '--set-upstream', 'origin', current_branch, quiet=False):
        return fail(f'pushing {current_branch} failed')

    if token is None:
        return fail(f'pushed {current_branch}, but found no github token to open the pull request with. '
                    'set GITHUB_TOKEN or store one in your git credential helper')

    title, body = pull_request_text(messages)
    pulls_path = f'/repos/{owner}/{repository_name}/pulls'
    try:
        head_query = urllib.parse.urlencode({'head': f'{owner}:{current_branch}', 'state': 'open'})
        existing = github_request('GET', f'{pulls_path}?{head_query}', token)
        if existing:
            pull_request = github_request('PATCH', f'{pulls_path}/{existing[0]["number"]}', token,
                                          {'title': title, 'body': body})
            print(f'updated pull request #{pull_request["number"]}{account_note(pull_request)}: {pull_request["html_url"]}')
        else:
            pull_request = github_request('POST', pulls_path, token, {'title': title, 'body': body, 'head': current_branch,
                                                                      'base': base, 'draft': options.draft})
            print(f'opened pull request #{pull_request["number"]}{account_note(pull_request)}: {pull_request["html_url"]}')
    except GitHubError as error:
        return fail(f'pushed {current_branch}, but github refused the pull request: {error}')

    if options.open:
        webbrowser.open(pull_request['html_url'])
    return 0


class LandingRefused(Exception):
    pass


def reviewer_line(approver_names):
    if not approver_names:
        return 'Unreviewed.'
    if len(approver_names) == 1:
        return f'Reviewed by {approver_names[0]}.'
    if len(approver_names) == 2:
        return f'Reviewed by {approver_names[0]} and {approver_names[1]}.'
    return f'Reviewed by {", ".join(approver_names[:-1])}, and {approver_names[-1]}.'


def review_outcome(reviews, author_login):
    # github keeps every review ever submitted; what counts is each reviewer's
    # most recent approve / request-changes / dismissal. comments don't change it
    latest_state = {}
    for review in reviews:
        login = (review.get('user') or {}).get('login')
        if login and login != author_login and review['state'] in ('APPROVED', 'CHANGES_REQUESTED', 'DISMISSED'):
            latest_state[login] = review['state']
    approvers = [login for login, state in latest_state.items() if state == 'APPROVED']
    blockers = [login for login, state in latest_state.items() if state == 'CHANGES_REQUESTED']
    return approvers, blockers


def with_reviewer(message, line):
    # only the untouched placeholder is replaced; a reviewer line someone wrote
    # by hand is left exactly as they wrote it
    lines = message.split('\n')
    return '\n'.join(line if existing == REVIEWER_PLACEHOLDER else existing for existing in lines)


def git_or_refuse(reason, *arguments, environment=None):
    result = subprocess.run(['git', *arguments], capture_output=True, text=True, env=environment)
    if result.returncode:
        raise LandingRefused(f'{reason}\n\n```\n{(result.stderr or result.stdout).strip()}\n```')
    return result.stdout.strip()


def land_pull_request(number, token, owner, repository_name):
    repository_path = f'/repos/{owner}/{repository_name}'
    pull_request = github_request('GET', f'{repository_path}/pulls/{number}', token)
    if pull_request['state'] != 'open':
        raise LandingRefused('the pull request is not open.')
    if pull_request.get('draft'):
        raise LandingRefused('the pull request is still a draft.')
    base = pull_request['base']['ref']
    default_branch = github_request('GET', repository_path, token)['default_branch']
    if base != default_branch:
        raise LandingRefused(f'the merge queue only lands into {default_branch}, but this pull request targets {base}.')

    reviews = github_request('GET', f'{repository_path}/pulls/{number}/reviews?per_page=100', token)
    approvers, blockers = review_outcome(reviews, pull_request['user']['login'])
    if blockers:
        raise LandingRefused(f'changes were requested by {", ".join("@" + login for login in blockers)}. '
                             'land it once they approve or their review is dismissed.')
    approver_names = [github_request('GET', f'/users/{login}', token).get('name') or login for login in approvers]

    # refs/pull/N/head exists for every pull request, including ones from forks
    git_or_refuse(f'couldn\'t fetch {base} and the pull request.', 'fetch', '--quiet', 'origin',
                  f'+refs/heads/{base}:refs/remotes/origin/{base}', f'+refs/pull/{number}/head:refs/sd1/landing')
    upstream = f'origin/{base}'
    git_or_refuse('couldn\'t check out the pull request.', 'checkout', '--quiet', '--detach', 'refs/sd1/landing')
    # rebase rather than cherry-pick: it drops commits whose changes already
    # landed, which happens when a branch is reused after an earlier landing
    rebase = subprocess.run(['git', 'rebase', '--quiet', upstream], capture_output=True, text=True)
    if rebase.returncode:
        subprocess.run(['git', 'rebase', '--abort'], capture_output=True)
        raise LandingRefused(f'the commits don\'t rebase cleanly onto the latest {base}. '
                             f'run `git-sd1 pr` to rebase and resolve the conflicts, then add the label again.')

    commits = commits_ahead(upstream)
    if not commits:
        raise LandingRefused(f'there is nothing to land; everything in this pull request is already in {base}.')
    messages = [commit_message(revision) for revision in commits]
    placeholders = unfinished_placeholders(messages)
    if placeholders:
        listed = '\n'.join(f'    {line}' for line in placeholders)
        raise LandingRefused(f'these lines still need filling in (fix them with `git-sd1 amend` and `git-sd1 pr`):\n\n```\n{listed}\n```')

    # replay the rebased commits with the reviewer line filled in. each commit
    # keeps its author, and is committed as that same person, so landing doesn't
    # add whoever (or whatever) ran the queue as a second name on github
    line = reviewer_line(approver_names)
    git_or_refuse('couldn\'t rewrite the commits.', 'checkout', '--quiet', '--detach', upstream)
    for revision, message in zip(commits, messages):
        author_name, author_email, author_date = git_output('log', '-1', '--format=%an%n%ae%n%aI', revision).split('\n')
        environment = {**os.environ,
                       'GIT_COMMITTER_NAME': author_name, 'GIT_COMMITTER_EMAIL': author_email,
                       'GIT_COMMITTER_DATE': author_date}
        git_or_refuse(f'couldn\'t replay {revision[:7]}.', 'cherry-pick', '--allow-empty', '--keep-redundant-commits',
                      revision, environment=environment)
        with tempfile.NamedTemporaryFile('w', suffix='.txt', delete=False, encoding='utf-8') as message_file:
            message_file.write(with_reviewer(message, line))
        try:
            git_or_refuse(f'couldn\'t rewrite the message of {revision[:7]}.', 'commit', '--quiet', '--amend',
                          '--no-verify', '--cleanup=verbatim', '--file', message_file.name, environment=environment)
        finally:
            os.unlink(message_file.name)
    landed = git_output('rev-parse', 'HEAD')

    head = pull_request['head']
    same_repository = (head.get('repo') or {}).get('full_name') == f'{owner}/{repository_name}'
    if same_repository:
        # pushing the landed commits to the pull request branch first means the
        # branch tip is exactly what lands, which is how github knows to show the
        # pull request as merged instead of closed
        git_or_refuse('couldn\'t update the pull request branch.', 'push', '--quiet', '--force', 'origin',
                      f'{landed}:refs/heads/{head["ref"]}')
    # not forced: if someone pushed to the base branch since the fetch, this
    # fails and nothing is overwritten
    git_or_refuse(f'couldn\'t push to {base}; it probably moved while landing. add the label again to retry.',
                  'push', '--quiet', 'origin', f'{landed}:refs/heads/{base}')
    return pull_request, landed, len(commits), line


def run_land(options):
    repository = github_repository()
    if repository is None:
        return fail('origin isn\'t a github remote')
    owner, repository_name = repository
    token = github_token()
    if token is None:
        return fail('found no github token; set GITHUB_TOKEN')
    repository_path = f'/repos/{owner}/{repository_name}'
    number = options.number

    def finish(comment):
        # the label is removed whether or not landing worked, so adding it again
        # is always how to retry
        github_request('POST', f'{repository_path}/issues/{number}/comments', token, {'body': comment})
        try:
            github_request('DELETE', f'{repository_path}/issues/{number}/labels/{MERGE_QUEUE_LABEL}', token)
        except GitHubError:
            pass

    if not git_succeeds('diff', '--quiet', 'HEAD'):
        return fail('commit or stash your changes first; landing checks out other commits')
    # landing works on a detached HEAD, so remember where to come back to when
    # it's run by hand instead of by the workflow
    original_position = git_output('symbolic-ref', '--quiet', '--short', 'HEAD') or git_output('rev-parse', 'HEAD')
    try:
        pull_request, landed, commit_count, line = land_pull_request(number, token, owner, repository_name)
    except LandingRefused as refusal:
        finish(f'The merge queue couldn\'t land this: {refusal}')
        return fail(f'refused to land #{number}: {refusal}')
    except GitHubError as error:
        finish(f'The merge queue couldn\'t land this: github returned an error ({error}).')
        return fail(f'github error while landing #{number}: {error}')
    finally:
        if original_position:
            git_succeeds('checkout', '--quiet', original_position)

    base = pull_request['base']['ref']
    commit_url = f'https://github.com/{owner}/{repository_name}/commit/{landed}'
    noun = 'commit' if commit_count == 1 else f'{commit_count} commits'
    finish(f'Landed {noun} on `{base}` as {commit_url} ({line.rstrip(".")}).')

    deadline = time.monotonic() + MERGED_POLL_SECONDS
    merged = False
    while True:
        merged = github_request('GET', f'{repository_path}/pulls/{number}', token).get('merged')
        if merged or time.monotonic() >= deadline:
            break
        time.sleep(1)
    if not merged:
        # forks, or github not catching up: close it by hand so nothing is left open
        github_request('PATCH', f'{repository_path}/pulls/{number}', token, {'state': 'closed'})

    head = pull_request['head']
    if (head.get('repo') or {}).get('full_name') == f'{owner}/{repository_name}':
        try:
            github_request('DELETE', f'{repository_path}/git/refs/heads/{urllib.parse.quote(head["ref"])}', token)
        except GitHubError:
            pass
    print(f'landed #{number} on {base} as {landed[:12]}')
    return 0


def main():
    # when run through the `git sd1` alias, git has already moved to the top of the
    # work tree and says where the command was typed in GIT_PREFIX. going back there
    # keeps relative paths like `git sd1 commit detection/fusion.py` meaning what they say
    typed_from = os.environ.pop('GIT_PREFIX', '')
    if typed_from:
        os.chdir(typed_from)

    parser = argparse.ArgumentParser(prog='git-sd1', description='repository helper for the 3d printing failure detector')
    subcommands = parser.add_subparsers(dest='command', required=True)

    setup_parser = subcommands.add_parser('setup', help='install the repository\'s git hooks into this clone')
    setup_parser.add_argument('--force', action='store_true', help='replace hooks that weren\'t installed by git-sd1')

    commit_parser = subcommands.add_parser('commit', help='commit with the structured message format',
                                           epilog='any other arguments are passed to git commit')
    commit_parser.add_argument('--issue', metavar='NUMBER_OR_URL', help='github issue to link under the title')

    subcommands.add_parser('amend', help='amend the last commit and refresh its file list, keeping what you wrote',
                           epilog='any other arguments are passed to git commit --amend')

    pr_parser = subcommands.add_parser(
        'pr', help='commit staged changes, push the branch, and open or update its pull request',
        description='staged changes become a new commit, or are folded into the branch\'s commit if it has one. '
                    'run from the base branch, your commits move onto a new eng/ branch first. a branch whose '
                    'earlier pull request is already closed asks before opening a second one from the same name. '
                    'the pull request title and description come from the commit message and are rewritten on every run.')
    pr_parser.add_argument('--issue', metavar='NUMBER_OR_URL', help='github issue to link if a new commit is made')
    pr_parser.add_argument('--base', help='branch to merge into (default: origin\'s default branch)')
    pr_parser.add_argument('--branch', help='name for the new branch when starting from the base branch')
    pr_parser.add_argument('--reuse-branch', action='store_true',
                           help='open a pull request from a branch name whose earlier pull request is closed, without asking')
    pr_parser.add_argument('--draft', action='store_true', help='open as a draft, which also allows (OOPS!) placeholders')
    pr_parser.add_argument('--no-rebase', action='store_true', help='push without rebasing onto the latest base first')
    pr_parser.add_argument('--open', action='store_true', help='open the pull request in a browser afterwards')

    land_parser = subcommands.add_parser(
        'land', help='rebase a pull request onto main and push it without a merge commit',
        description='fills in the reviewer line from github approvals ("Unreviewed." if there are none), '
                    'rebases the commits onto the latest base branch, pushes them, comments with the result, '
                    'and removes the merge-queue label. the merge-queue workflow runs this.')
    land_parser.add_argument('number', type=int, help='pull request number')

    options, extra_arguments = parser.parse_known_args()
    if options.command not in ('commit', 'amend') and extra_arguments:
        parser.error(f'unrecognized arguments: {" ".join(extra_arguments)}')
    if options.command == 'setup':
        return run_setup(options)
    if options.command == 'pr':
        return run_pr(options)
    if options.command == 'land':
        return run_land(options)
    if options.command == 'amend':
        return run_amend(extra_arguments)
    return run_commit(options, extra_arguments)


if __name__ == '__main__':
    sys.exit(main())
